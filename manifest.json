{
   "manifest_version": 3,
   "name": "Phrase - TP",
   "version": "3.8",
   "description": "Phrases prêtes à copier, rangées par listes et rubriques, et chemins de menus du logiciel ID.",
   "minimum_chrome_version": "116",
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "side_panel": {
      "default_path": "popup.html"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+Z"
         },
         "description": "Ouvrir ZenText"
      }
   },
   "permissions": [
      "sidePanel"
   ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "update_url": "https://clients2.google.com/service/update2/crx"
}
